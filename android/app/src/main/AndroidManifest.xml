<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Required at runtime on API 33+ (Android 13) — without it, FCM
         messages still arrive but the OS silently drops the system-tray
         notification instead of showing it. PushNotificationService
         requests it via FirebaseMessaging.instance.requestPermission(). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Yello is installed from an APK rather than from a store, so it
         fetches and installs its own updates (ADR-029). This lets the app
         ask the OS package installer to open the build it downloaded; the
         user still confirms every install, and still has to grant "install
         unknown apps" to Yello once. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Voice messages. Asked for at the moment the recorder opens, by
         `record`'s own hasPermission() — a refusal is handled in the sheet
         rather than on the way into the chat, so a user who never sends one
         is never asked. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <application
        android:label="Yello."
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Channel a backgrounded/killed-app push is shown under — the OS
             draws that notification straight from the FCM payload without
             ever running Dart code, so it needs the channel id natively.
             `yello_default` is the id yello-notify's guide names; it must
             match `_androidChannel.id` in PushNotificationService. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="yello_default" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Receives the notification's direct-reply action (RemoteInput)
             and starts flutter_local_notifications' own background engine
             so the reply can be sent from Dart without bringing the app
             forward. Without this declaration the Reply button is drawn but
             tapping Send does nothing at all. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />
        <!-- Hands the downloaded APK to the package installer, which is a
             different app and cannot read Yello's private cache without a
             content URI. Authority must match MainActivity.kt's
             "$packageName.fileprovider". -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
