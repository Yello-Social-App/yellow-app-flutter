{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter analyze)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get)",
      "Bash(flutter pub outdated)",
      "Bash(flutter pub deps:*)",
      "Bash(dart format --line-length=120:*)",
      "Bash(bash tool/codemap.sh)",
      "Bash(bash tool/codemap.sh --check)",
      "Bash(bash tool/session_brief.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Read(./android/app/google-services.json)",
      "Read(./android/key.properties)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./ios/**/GoogleService-Info.plist)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash tool/session_brief.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
